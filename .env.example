NODE_ENV=development
APP_ENV=demo
PORT=3000
FRONTEND_URL=http://localhost:5173

# Vercel Neon (PostgreSQL)
# Pooled connection string (with -pooler in host) for runtime queries
DATABASE_URL="postgresql://user:pass@ep-cool-darkness-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (without -pooler) for migrations
DIRECT_URL="postgresql://user:pass@ep-cool-darkness-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Upstash (Redis REST API)
UPSTASH_REDIS_REST_URL="https://us1-merry-cat-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# Auth & Demo (replace with strong random secrets in production)
JWT_ACCESS_SECRET="replace-with-at-least-32-chars-random-access-secret"
JWT_REFRESH_SECRET="replace-with-at-least-32-chars-random-refresh-secret"
DEMO_OTP="123456"

# AI (OpenAI-compatible: DeepSeek / Kimi / OpenAI) & VoiceLab
AI_API_KEY="your-ai-api-key"
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-chat"
AI_VISION_MODEL="gpt-4o-mini"
AI_DAILY_LIMIT=50
VOICELAB_API_KEY="your-voicelab-api-key"
VOICELAB_BASE_URL="https://api.voicelab.uz/v1"
